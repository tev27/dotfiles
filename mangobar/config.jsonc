{
    "layer": "top",
    "height": 20,
    "modules-left": ["workspaces", "custom/luks-keystore"],
    "modules-center": ["clock#date", "clock#time"],
    "modules-right": ["battery"],
    "sys-interval": 2,

    // modules
    "clock#data": {
	"format": "{:L%m-%d %a}"
    },
    "clock#time": {
	"format": "{:L%H:%M:%S}"
    },

    "custom/luks-keystore": {
	"exec": "~/dotfiles/mangobar/luks-umount-module.sh"
    }
}
